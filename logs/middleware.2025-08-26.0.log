    id: dhis2-upload-csv-sync-raw-only
    description: "POST /external/integrate — RAW/Binary CSV only using CsvGuard bean"
    from:
      uri: servlet:/external/integrate
      parameters:
        httpMethodRestrict: POST
      steps:
        # فحص/حماية CSV
        - process:
            ref: csvGuard

        # إيقاف مبكر إذا CsvGuard علّم على التوقف
        - choice:
            when:
              - simple: "${header.CamelRouteStop} == 'true'"
                steps:
                  - stop: {}

        # الاتصال بـ DHIS2 — منع تمرير Authorization/Content-Length/… عبر HeaderFilterStrategy
        - to:
            uri: "{{dhis2.base-url}}/api/dataValueSets"
            parameters:
              authenticationPreemptive: true
              authUsername: "{{dhis2.username}}"
              authPassword: "{{dhis2.password}}"
              throwExceptionOnFailure: false
              bridgeEndpoint: true
            ]
