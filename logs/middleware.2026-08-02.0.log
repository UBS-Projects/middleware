    id: person-lookup-unified
    description: Civil Status (SOAP) → fallback Borders (REST) → unified JSON response

    from:
      uri: rest:post:/api/person/lookup
      steps:

        - unmarshal:
            json:
              library: Jackson
        - setProperty: { name: nationalNo, simple: "${body[nationalNo]}" }
        - setProperty: { name: birthDate,  simple: "${body[BIRTH_DATE]}" }

        # ─── 0. Validate DHIS2 Session & Authority ─────────────────────────

        - choice:
            when:
              - simple: "${header.Cookie} == null || ${header.Cookie} == ''"
                steps:
                  - setHeader: { name: CamelHttpResponseCode, constant: 401 }
                  - setHeader: { name: Content-Type, constant: 'application/json' }
                  - setBody:
                      constant: '{"status":"ERROR","message":"Missing DHIS2 session"}'
                  - stop: {}

     ]
