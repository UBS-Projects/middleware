- onException:
    exception:
      - java.lang.Exception
    handled:
      constant: true
    steps:
      # التقط نص ومعلومات الخطأ
      - setProperty: { name: _errMsg,  simple: "${exception.message}" }
      - setProperty: { name: _errBody, simple: "${bodyAs(String)}" }

      # إذا كان لدينا UUID سابقًا، سجّل الخطأ وأكمل العملية كفشل
      - choice:
          when:
            - simple: "${exchangeProperty._opUuid} != null"
              steps:
                - toD: "bean:operationLogService?method=logError(${exchangeProperty._opUuid}, ${exception}, 'Route error')"
                - setBody:
                    simple: '{"status":"ERROR","message":"${exchangeProperty._errMsg}"}'
                - setHeader: { name: Content-Type, constant: "application/json; charset=UTF-8" }
               ]
