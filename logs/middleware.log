- route:
    id: http-entry-generic-api
    description: "HTTP gateway for /integration/api/{API_NAME}"
    from:
      uri: servlet:/integration/api/*
      parameters:
        httpMethodRestrict: GET
      steps:
        # Example of CamelHttpPath: /integration/api/HEALTHMAP_API_V2B
        - setProperty: { name: _rawPath, simple: "${header.CamelHttpPath}" }
        - setProperty:
            name: _apiRaw
            simple: "${exchangeProperty._rawPath.replaceAll('^.*/api/','')}"  # => HEALTHMAP_API_V2B or HHO

        # Normalize HEALTHMAP_API_V2A/V2B → HEALTHMAP_API, otherwise keep as-is
        - choice:
            when:
              - simple: "${exchangeProperty._apiRaw} regex '^HEALTHMAP_API(_V2[AB])?$'"
                steps:
                  - setHeader: { name: apiName, constant: "HEALTHMAP_API" }
            otherwise:
              steps:
                - setHeader: { name: apiName, ]
