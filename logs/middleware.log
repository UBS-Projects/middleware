- route:
    id: dhis2-upload-csv-sync-raw-only-http-simple
    description: "POST /external/integrate - HTTP simple"
    from:
      uri: servlet:/external/integrate
      parameters:
        httpMethodRestrict: POST
      steps:
        - convertBodyTo: { type: java.lang.String }
        - convertBodyTo: { type: "byte[]" }
        - setProperty: { name: _csvBytes, simple: "${body}" }

        - setProperty: { name: scheme, constant: CODE }
        - setProperty: { name: strategy, constant: NEW_AND_UPDATES }
        - setProperty:
            name: _queryBase
            simple: "async=false&preheatCache=false&skipAudit=false&skipExistingCheck=false&firstRowIsHeader=true&strategy=NEW_AND_UPDATES&dataElementIdScheme=CODE&orgUnitIdScheme=CODE&categoryOptionComboIdScheme=CODE&attributeOptionComboIdScheme=CODE&idScheme=CODE"

        - setProperty: { name: dryRun, constant: "true" }
        - choice:
            when:
              - simple]
