- route:
    id: http-entry-integration-api-dynamic
    description: "Dynamic /integration/api/{apiName} (matchOnUriPrefix)"
    from:
      uri: servlet:/integration/api
      parameters:
        httpMethodRestrict: GET
        matchOnUriPrefix: true
      steps:
        # أمثلة مسار: /integration/api/HEALTHMAP_API_V2B أو /integration/api/HEALTHMAP_API
        - setProperty:
            name: _rawPath
            simple: "${header.CamelHttpPath}"   # يعطي: /HEALTHMAP_API أو /HHW_V1...
        - setProperty:
            name: apiNameRaw
            simple: "${exchangeProperty._rawPath.replaceAll('^.*/api/','')}"  # يبقى غالباً: /HEALTHMAP_API
        # إزالة أي سلاشات في بداية الاسم → HEALTHMAP_API
        - setProperty:
            name: apiNameClean
            simple: "${exchangeProperty.apiNameRaw.replaceAll('^/+','')}"

        # ===========]
