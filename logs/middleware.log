2025-08-20 11:50:36 [http-nio-8081-exec-7] INFO  c.m.b.k.service.DynamicRouteService - found [DynamicRouteEntity(id=69, routeId=get-integration-api-healthmap-v2b, description=Return HEALTHMAP_API mappings with DHIS2 values (V2B), version=1, path=/integration/api/HEALTHMAP_API_V2B, httpMethod=GET, yamlContent=# ========= HTTP entry =========
- route:
    id: http-entry-healthmap-v2b
    description: "HTTP gateway for HEALTHMAP_API_V2B"
    from:
      uri: servlet:/integration/api/HEALTHMAP_API_V2B
      parameters:
        httpMethodRestrict: GET
      steps:
        - to: "direct:healthmap_logic_v2b"

# ========= Core logic =========
- route:
    id: get-integration-api-healthmap-v2b
    description: "Return HEALTHMAP_API mappings with DHIS2 values (V2B)"
    from:
      uri: direct:healthmap_logic_v2b
      steps:
        # normalize headers
        - setHeader: { name: apiName,   constant: HEALTHMAP_API }
        - setHeader: { name: datasetId, simple: "${header.dataSet}" }
        - setHeader: { name: orgUnit,   simple: "${header.orgUnit}" }
        - setHeader: { name: period,    simple: "${header.period}" }

        # fetch mappings (filtered by dataset if provided)
        - choice:
            when:
              - simple: "${header.datasetId} != null && ${header.datasetId} != ''"
                steps:
                  - to:
                      uri: "sql:SELECT id, api_name, external_system, external_key, dataset_id, data_element_id, category_option_combo_id, attribute_option_combo_id, is_active, notes, created_at FROM api_mappings WHERE api_name = :#apiName AND is_active = TRUE AND dataset_id = :#datasetId ORDER BY id"
                      parameters:
                        outputType: SelectList
            otherwise:
              steps:
                - to:
                    uri: "sql:SELECT id, api_name, external_system, external_key, dataset_id, data_element_id, category_option_combo_id, attribute_option_combo_id, is_active, notes, created_at FROM api_mappings WHERE api_name = :#apiName AND is_active = TRUE ORDER BY id"
                    parameters:
                      outputType: SelectList

        # split over rows
        - split:
            simple: "${body}"
            steps:
              - setProperty: { name: row, simple: "${body}" }
              - setProperty: { name: _ext, simple: "${exchangeProperty.row[external_key]}" }
              - setProperty: { name: _ds,  simple: "${exchangeProperty.row[dataset_id]}" }
              - setProperty: { name: _de,  simple: "${exchangeProperty.row[data_element_id]}" }
              - setProperty: { name: _coc, simple: "${exchangeProperty.row[category_option_combo_id]}" }
              - setProperty: { name: _aoc, simple: "${exchangeProperty.row[attribute_option_combo_id]}" }

              # إذا ما انرسلت orgUnit/period رجّع not found
              - choice:
                  when:
                    - simple: "${header.orgUnit} == null || ${header.orgUnit} == '' || ${header.period} == null || ${header.period} == ''"
                      steps:
                        - setProperty: { name: _val,   constant: null }
                        - setProperty: { name: _found, constant: false }
                  otherwise:
                    steps:
                      # call DHIS2
                      - removeHeaders: "*"
                      - setHeader: { name: Accept, constant: application/json }
                      - toD: "{{dhis2.base-url}}/api/dataValues?httpMethod=GET&de=${exchangeProperty._de}&pe=${header.period}&ou=${header.orgUnit}&co=${exchangeProperty._coc}&ao=${exchangeProperty._aoc}&authenticationPreemptive=true&authUsername={{dhis2.username}}&authPassword={{dhis2.password}}&throwExceptionOnFailure=false&connectTimeout={{dhis2.connect-timeout:10000}}&socketTimeout={{dhis2.timeout:30000}}"
                      - setProperty: { name: _code,    simple: "${header.CamelHttpResponseCode}" }
                      - setProperty: { name: _respStr, simple: "${bodyAs(String)}" }

                      - choice:
                          when:
                            - simple: "${exchangeProperty._code} == 200"
                              steps:
                                # 1) { "value": "X" }
                                - choice:
                                    when:
                                      - simple: "${exchangeProperty._respStr} contains '\"value\"'"
                                        steps:
                                          - unmarshal:
                                              json:
                                                library: Jackson
                                          - setProperty: { name: _val,   jsonpath: "$.value" }
                                          - setProperty: { name: _found, constant: true }
                                    otherwise:
                                      steps:
                                        # 2) ["X"]  — استخدم regex بدل startsWith()
                                        - choice:
                                            when:
                                              - simple: "${exchangeProperty._respStr} regex '^\\s*\\['"
                                                steps:
                                                  - unmarshal:
                                                      json:
                                                        library: Jackson
                                                  - setProperty: { name: _val,   jsonpath: "$[0]" }
                                                  - setProperty: { name: _found, constant: true }
                                            otherwise:
                                              steps:
                                                # 3) "X" أو X — نظّف الاقتباسات
                                                - setProperty: { name: _val,   simple: "${exchangeProperty._respStr.trim().replace('\"','')}" }
                                                - setProperty: { name: _found, constant: true }
                          otherwise:
                            steps:
                              - setProperty: { name: _val,   constant: null }
                              - setProperty: { name: _found, constant: false }

              # جهّز القيمة للإخراج: إذا ليست null لفّها بين ""
              - choice:
                  when:
                    - simple: "${exchangeProperty._val} != null"
                      steps:
                        - setProperty: { name: _valOut, simple: "\"${exchangeProperty._val}\"" }
                  otherwise:
                    steps:
                      - setProperty: { name: _valOut, constant: null }

              # body النهائي
              - setBody:
                  simple: |
                    { "externalKey": "${exchangeProperty._ext}",
                      "datasetId": "${exchangeProperty._ds}",
                      "dataElementId": "${exchangeProperty._de}",
                      "categoryOptionComboId": "${exchangeProperty._coc}",
                      "attributeOptionComboId": "${exchangeProperty._aoc}",
                      "value": ${exchangeProperty._valOut},
                      "dataFound": ${exchangeProperty._found} }, active=true, defaultVersion=true, createdAt=2025-08-20T11:48:42.309816, comment=null)] versions
