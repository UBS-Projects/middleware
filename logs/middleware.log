    id: dhis2-upload-csv-like-dhis2
    description: "POST /external/integrate — accepts RAW or multipart (part name 'file'); default async=true; ?scheme=UID|CODE|NAME (default=CODE)"
    from:
      uri: servlet:/external/integrate
      parameters:
        httpMethodRestrict: POST
      steps:
        # 1) اكتشف نوع المحتوى من HttpServletRequest أولاً
        - setProperty:
            name: _ct
            simple: "${header.CamelHttpServletRequest != null ? header.CamelHttpServletRequest.getContentType() : header[Content-Type]}"

