                  - stop: {}
        - setProperty: { name: _csvString, simple: "${body}" }
        - setBody: { simple: "${exchangeProperty._csvString}" }
        - convertBodyTo: { type: "byte[]" }
        - setHeader: { name: Content-Type,    constant: application/csv }
        - setHeader: { name: Accept,          constant: "*/*" }
        - setHeader: { name: CamelHttpMethod, constant: POST }
