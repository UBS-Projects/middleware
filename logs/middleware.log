      steps:
        # normalize headers
        - setHeader: { name: apiName,   constant: HEALTHMAP_API }
        - setHeader: { name: datasetId, simple: "${header.dataSet}" }
        - setHeader: { name: orgUnit,   simple: "${header.orgUnit}" }
        - setHeader: { name: period,    simple: "${header.period}" }

        # fetch mappings (filtered by dataset if provided)
        - choice:
            when:
              - simple: "${header.datasetId} != null && ${header.datasetId]
