# Route: HTTP entry
# =========================
- route:
    id: http-entry-healthmap-v2b
    description: "HTTP gateway for HEALTHMAP_API_V2B"
    from:
      uri: servlet:/integration/api/HEALTHMAP_API_V2B
      parameters:
        httpMethodRestrict: GET
      steps:
        # تحقق أساسي من المدخلات (allowlist/regex)
        - choice:
            when:
              - simple: "${header.orgUnit} regex '^[A-Za-z0-9]{5,}$' && ${header.period} regex '^[0-9]{6}$'"
                steps:
                  - to: direct:healthmap_logic_v2b
            otherwise:
              steps:
                - setHeader:
                    name: Content-Type
                    constant: application/json; charset=UTF-8
                - setBody:
                    simple: >
                      {"error":"Invalid or missing parameters. Expect orgUnit (alnum>=5) and period (YYYYMM)."}
                - setHeader:
                    name: CamelHttpRespo]
