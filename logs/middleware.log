- route:
    id: http-entry-healthmap
    description: "HTTP gateway for HEALTHMAP_API"
    from:
      uri: servlet:/integration/api/HEALTHMAP_API
      parameters:
        httpMethodRestrict: GET
      steps:
        - to: "direct:healthmap_logic"

# ========= Core logic =========
- route:
    id: get-integration-api-healthmap
    description: "Return HEALTHMAP_API mappings with DHIS2 values"
    from:
      uri: direct:healthmap_logic
      steps:
        # normalize headers
        - setHeader: { name: apiName,   constant: HEALTHMAP_API }
        - setHeader: { name: datasetId, simple: "${header.dataSet}" }
        - setHeader: { name: orgUnit,   simple: "${header.orgUnit}" }
        - setHeader: { name: period,    simple: "${header.period}" }

        # fetch mappings (filtered by dataset if provided)
        - choice:
            when:
              - simple: "${header.datasetId} != null && ${header.datasetId} != ''"
                steps:
       ]
