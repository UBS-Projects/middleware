- route:
    id: get-neon-error-mappings
    description: Get error mappings from external Neon PostgreSQL database
    from:
      uri: rest
      parameters:
        method: get
        path: /v1/error-mappings
      steps:
        - to:
            id: query-error-mappings
            uri: "sql:SELECT * FROM public.error_mapping ORDER BY id ASC"
            parameters:
              dataSource: "#neonPostgresDataSource"
              outputType: SelectList

        - marshal:
            json:
              library: Jackson

        - setHeader:
            name: Content-Type
            constant: application/json]
