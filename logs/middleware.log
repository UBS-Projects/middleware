    id: http-entry-integration-api-dynamic
    description: "Dynamic /integration/api/{apiName} (matchOnUriPrefix)"
    from:
      uri: servlet:/integration/api
      parameters:
        httpMethodRestrict: GET
        matchOnUriPrefix: true
      steps:
        - setProperty: { name: _rawPath,   simple: "${header.CamelHttpPath}" }
        - setProperty: { name: apiNameRaw, simple: "${exchangeProperty._rawPath.replaceAll('^.*/api/','')}" }
        - setProperty: { name: apiNameClean, simple: "${exchangeProperty.apiNameRaw.replaceAll('^/+','')}" }
        - choice:
            when:
              - simple: "${exchangeProperty.apiNameClean} regex '(?i)^HEALTHMAP_API(_V2[AB])?$'"
                steps:
                  - setHeader: { name: apiName, constant: HEALTHMAP_API }
            otherwise:
              steps:
                - setHeader: { name: apiName, simple: "${exchangeProperty.apiNameClean}" }
        - to: { uri: direct:integration_api_logic }

- route:
    id: ge]
