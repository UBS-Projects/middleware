- route:
    id: http-entry-integration-api-dynamic
    description: "Dynamic /integration/api/{apiName} (matchOnUriPrefix)"
    from:
      uri: servlet:/integration/api
      parameters:
        httpMethodRestrict: GET
        matchOnUriPrefix: true
    steps:
      # مثال لمسار وارد: /integration/api/HEALTHMAP_API_V2B
      - setProperty:
          name: _rawPath
          simple: "${header.CamelHttpPath}"
      - setProperty:
          name: apiNameRaw
          simple: "${exchangeProperty._rawPath.replaceAll('^.*/api/','')}"
      # ==================[ تطبيع أسماء API اختيارياً ]==================
      - choice:
          when:
            # HEALTHMAP_API أو HEALTHMAP_API_V2A أو HEALTHMAP_API_V2B ⇒ HEALTHMAP_API
            - simple: "${exchangeProperty.apiNameRaw} regex '^HEALTHMAP_API(_V2[AB])?$'"
              steps:
                - setHeader: { name:]
