- route:
    id: http-entry-healthmap-v2
    description: "HTTP gateway for HEALTHMAP_API_V2"
    from:
      uri: servlet:/integration/api/HEALTHMAP_API_V2
      parameters:
        httpMethodRestrict: GET
      steps:
        - to: "direct:healthmap_logic_v2"

# ========= Core logic =========
- route:
    id: get-integration-api-healthmap-v2
    description: "Return HEALTHMAP_API mappings with DHIS2 values (V2)"
    from:
      uri: direct:healthmap_logic_v2
      steps:
        # normalize headers
        - setHeader: { name: apiName,   constant: HEALTHMAP_API }
        - setHeader: { name: datasetId, simple: "${header.dataSet}" }
        - setHeader: { name: orgUnit,   simple: "${header.orgUnit}" }
        - setHeader: { name: period,    simple: "${header.period}" }

        # fetch mappings (filtered by dataset if provided)
        - choice:
            when:
              - simple: "${header.datasetId} != null && ${header.datasetId} != ''"
       ]
