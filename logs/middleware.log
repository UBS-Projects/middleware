                                name: _val
                                simple: '"${body}"'
                            - setProperty:
                                name: _found
                                constant: true
                          otherwise:
                            steps:
                            - setProperty:
                                name: _val
                                constant: null
                            - setProperty:
                                name: _found
                                constant: false
          - setBody:
              simple: |
                {"externalKey":"${exchangeProperty._ext}","dataElementId":"${exchangeProperty._de}","value":${exchangeProperty._val},"dataFound":${exchangeProperty._found}}
          - unmarshal:
              json:
                library: Jackson
      - marshal:
          json:
            library: Jackson
      - unmarshal:
          json:
            library: Jackson
      - choice:
          when:
          - simple: ${exchangeProperty.onlyFound} == 'true'
            steps:
            - setBody:
                jsonpath: $[?(@.dataFound == true)]
          otherwise:
            steps:
            - setBody:
                jsonpath: $[*]
      - marshal:
          json:
            library: Jackson
      - setHeader:
          name: Content-Type
          constant: application/json; charset=UTF-8

