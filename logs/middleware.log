                                      name: val
                                      constant: null
                                  - log:
                                      message: Regex failed to extract value
                          otherwise:
                            steps:
                            - setProperty:
                                name: val
                                constant: null
                            - log:
                                message: No value field in response
                    otherwise:
                      steps:
                      - log:
                          message: DHIS2 failed with ${header.CamelHttpResponseCode}
                      - setProperty:
                          name: val
                          constant: null
                      - setProperty:
                          name: found
                          constant: false
          - choice:
              when:
              - simple: ${exchangeProperty.val} != null && ${exchangeProperty.val}
                  != 'null'
                steps:
                - setProperty:
                    name: currentItem
                    simple: '{"externalKey":"${exchangeProperty.ext}","datasetId":"${exchangeProperty.ds}","dataElementId":"${exchangeProperty.de}","categoryOptionComboId":"${exchangeProperty.coc}","attributeOptionComboId":"${exchangeProperty.aoc}","value":"${exchangeProperty.val}","dataFound":${exchangeProperty.found}}'
              otherwise:
                steps:
                - setProperty:
                    name: currentItem
                    simple: '{"externalKey":"${exchangeProperty.ext}","datasetId":"${exchangeProperty.ds}","dataElementId":"${exchangeProperty.de}","categoryOptionComboId":"${exchangeProperty.coc}","attributeOptionComboId":"${exchangeProperty.aoc}","value":null,"dataFound":${exchangeProperty.found}}'
          - choice:
              when:
              - simple: ${exchangeProperty.currentIndex} == 0
                steps:
                - setProperty:
                    name: jsonResults
                    simple: ${exchangeProperty.currentItem}
              otherwise:
                steps:
                - setProperty:
                    name: jsonResults
                    simple: ${exchangeProperty.jsonResults},${exchangeProperty.currentItem}
      - setBody:
          simple: '[${exchangeProperty.jsonResults}]'
      - setHeader:
          name: Content-Type
          constant: application/json
      - setHeader:
          name: CamelHttpResponseCode
          constant: 200

