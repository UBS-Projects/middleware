              steps:
                - choice:
                    when:
                      - simple: "${header.CamelFileName} == null || ${header.CamelFileName} == ''"
                        steps:
                          - setHeader:
                              name: CamelFileName
                              constant: uploaded.csv
        - convertBodyTo: { type: java.lang.String }
        - choice:
            when:
