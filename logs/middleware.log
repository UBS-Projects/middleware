# sslContextParameters=#trustAllSSLContext
# بـ
# sslContextParametersRef=trustAllSSLContext (بدون #)
# أو احذفه نهائياً واستخدم HTTP parameters

- route:
    id: dhis2-upload-csv-sync-raw-only-simple-ssl
    description: "POST /external/integrate - SSL fixed with simple approach"
    from:
      uri: servlet:/external/integrate
      parameters:
        httpMethodRestrict: POST
      steps:
        - convertBodyTo: { type: java.lang.String }
        - convertBodyTo: { type: "byte[]" }
        - setProperty: { name: _csvBytes, simple: "${body}" }

        - setProperty: { name: scheme, constant: CODE }
        - choice:
            when:
              - simple: "${header.scheme} regex '(?i)^uid$'"
                steps: [ { setProperty: { name: scheme, constant: UID } } ]
              - simple: "${header.scheme} regex '(?i)^code$'"
                steps: [ { setProperty: { name: scheme, constant: CODE } } ]

      ]
