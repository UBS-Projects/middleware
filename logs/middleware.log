- route:
    id: dhis2-upload-csv-sync-raw-only-ssl-fixed
    description: "POST /external/integrate with SSL fix"
    from:
      uri: servlet:/external/integrate
      parameters:
        httpMethodRestrict: POST
      steps:
        - convertBodyTo: { type: java.lang.String }
        - convertBodyTo: { type: "byte[]" }
        - setProperty: { name: _csvBytes, simple: "${body}" }

        - setProperty: { name: scheme, constant: CODE }
        - choice:
            when:
              - simple: "${header.scheme} regex '(?i)^uid$'"
                steps: [ { setProperty: { name: scheme, constant: UID } } ]
              - simple: "${heade]
