                          uri: "{{dhis2.base-url}}/api/dataValues?httpMethod=GET&de=${exchangeProperty._de}&pe=${exchangeProperty.period}&ou=${exchangeProperty.orgUnit}&co=${exchangeProperty._coc}&ao=${exchangeProperty._aoc}&authenticationPreemptive=true&authUsername={{dhis2.username}}&authPassword={{dhis2.password}}&throwExceptionOnFailure=false&connectTimeout={{dhis2.connect-timeout:10000}}&socketTimeout={{dhis2.timeout:30000}}"
                      - setProperty: { name: _code, simple: "${header.CamelHttpResponseCode}" }
                      - setProperty: { name: _resp, simple: "${bodyAs(String)}" }

                      # JSON-first بدون regex/try-catch
                      - choice:
                          when:
                            - simple: "${exchangeProperty._code} == 200 && ${exchangeProperty._resp} startsWith '{'"
                              steps:
                                - unmarshal: { json: { library: Jackson } }
                                - choice:
                                    when:
                                      - simple: "${body[value]} != null"
                                        steps:
                                          - setProperty: { name: _val, simple: "\"${body[value]}\"" }
                                          - setProperty: { name: _found, constant: true }
                                    otherwise:
                                      steps:
                                        - setProperty: { name: _val,   constant: null }
                                        - setProperty: { name: _found, constant: false }
                          otherwise:
                            steps:
                              - choice:
                                  when:
                                    - simple: "${exchangeProperty._code} == 200 && ${exchangeProperty._resp} startsWith '['"
                                      steps:
                                        - unmarshal: { json: { library: Jackson } }
                                        - setBody:    { jsonpath: "$[0]" }
                                        - setProperty: { name: _val, simple: "\"${body}\"" }
                                        - setProperty: { name: _found, constant: true }
                                  otherwise:
                                    steps:
                                      - setProperty: { name: _val,   constant: null }
                                      - setProperty: { name: _found, constant: false }

              - choice:
                  when:
                    - simple: "${exchangeProperty._found}"
                      steps:
                        - setBody:
                            simple: >
                              {"externalKey":"${exchangeProperty._ext}","dataElementId":"${exchangeProperty._de}","value":${exchangeProperty._val},"dataFound":true}
                        - unmarshal: { json: { library: Jackson } }
                  otherwise:
                    steps:
                      - setBody: { simple: "${null}" }

        - marshal:   { json: { library: Jackson } }
        - unmarshal: { json: { library: Jackson } }
        - setBody:   { jsonpath: "$[?(@ != null)]" }
        - marshal:   { json: { library: Jackson } }
