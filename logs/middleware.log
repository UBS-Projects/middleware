2025-08-21 13:16:22 [http-nio-8081-exec-10] INFO  c.m.b.k.service.DynamicRouteService - found [DynamicRouteEntity(id=79, routeId=get-integration-api-healthmap-v2b, description=Return HEALTHMAP_API mappings with DHIS2 values (V2B), version=1, path=/integration/api/HEALTHMAP_API_V2B, httpMethod=GET, yamlContent=# =============[ 0) التقاط الأخطاء العامة وتسجيلها — يجب أن يسبق أي routes ]=============
- onException:
    exception:
      - java.lang.Exception
    handled:
      constant: true
    steps:
      # التقط نص ومعلومات الخطأ
      - setProperty: { name: _errMsg,  simple: "${exception.message}" }
      - setProperty: { name: _errBody, simple: "${bodyAs(String)}" }

      # إذا كان لدينا UUID سابقًا، سجّل الخطأ وأكمل العملية كفشل
      - choice:
          when:
            - simple: "${exchangeProperty._opUuid} != null"
              steps:
                - toD: "bean:operationLogService?method=logError(${exchangeProperty._opUuid}, ${exception}, 'Route error')"
                - setBody:
                    simple: '{"status":"ERROR","message":"${exchangeProperty._errMsg}"}'
                - setHeader: { name: Content-Type, constant: "application/json; charset=UTF-8" }
                - toD: "bean:operationLogService?method=completeOperation(${exchangeProperty._opUuid}, false, ${bodyAs(String)})"
          otherwise:
            steps:
              # لو ما في UUID (تعطل قبل startOperation) نرجّع JSON بسيط بس
              - setBody:
                  simple: '{"status":"ERROR","message":"${exchangeProperty._errMsg}"}'
              - setHeader: { name: Content-Type, constant: "application/json; charset=UTF-8" }

# =============[ 1) نقطة دخول HTTP ]=============
- route:
    id: http-entry-healthmap-v2b
    description: "HTTP gateway for HEALTHMAP_API_V2B"
    from:
      uri: servlet:/integration/api/HEALTHMAP_API_V2B
      parameters:
        httpMethodRestrict: GET
      steps:
        - to: { uri: direct:healthmap_logic_v2b }

# =============[ 2) لوجيك الراوت + التسجيل في operation_log ]=============
- route:
    id: get-integration-api-healthmap-v2b
    description: "Return HEALTHMAP_API mappings with DHIS2 values (V2B)"
    from:
      uri: direct:healthmap_logic_v2b
      steps:
        # --------- [A] بداية العملية (startOperation) ----------
        - setHeader:   { name: apiName,   constant: HEALTHMAP_API }
        - setHeader:   { name: datasetId, simple: "${header.dataSet}" }
        - setProperty: { name: orgUnit,   simple: "${header.orgUnit}" }
        - setProperty: { name: period,    simple: "${header.period}" }
        - setProperty: { name: onlyFound, simple: "${header.onlyFound}" }

        - setProperty:
            name: _opUuid
            simple: "${bean:operationLogService?method=startOperation(${header.apiName})}"

        - toD: "bean:operationLogService?method=logDhis2Request(${exchangeProperty._opUuid}, ${exchangeProperty.orgUnit}, ${exchangeProperty.period}, ${header.datasetId})"

        # --------- [B] جلب المابينغ ----------
        - choice:
            when:
              - simple: "${header.datasetId} != null && ${header.datasetId} != ''"
                steps:
                  - to:
                      uri: "sql:SELECT id, api_name, external_system, external_key, dataset_id, data_element_id, category_option_combo_id, attribute_option_combo_id, is_active, notes, created_at FROM integration_mapping WHERE api_name = :#apiName AND is_active = TRUE AND dataset_id = :#datasetId ORDER BY id"
                      parameters: { outputType: SelectList }
            otherwise:
              steps:
                - to:
                    uri: "sql:SELECT id, api_name, external_system, external_key, dataset_id, data_element_id, category_option_combo_id, attribute_option_combo_id, is_active, notes, created_at FROM integration_mapping WHERE api_name = :#apiName AND is_active = TRUE ORDER BY id"
                    parameters: { outputType: SelectList }

        - choice:
            when:
              - simple: "${body} == null || ${body.size} == 0"
                steps:
                  - setHeader: { name: Content-Type, constant: "application/json; charset=UTF-8" }
                  - setBody:   { constant: "[]" }
                  - toD: "bean:operationLogService?method=completeOperation(${exchangeProperty._opUuid}, true, ${bodyAs(String)})"
                  - stop: {}

        # --------- [C] الاستعلام DHIS2 + تسجيل الرد ----------
        - split:
            simple: "${body}"
            streaming: true
            aggregationStrategy: "#class:org.apache.camel.processor.aggregate.GroupedBodyAggregationStrategy"
            steps:
              - setProperty: { name: _row, simple: "${body}" }
              - setProperty: { name: _ext, simple: "${exchangeProperty._row[external_key]}" }
              - setProperty: { name: _ds,  simple: "${exchangeProperty._row[dataset_id]}" }
              - setProperty: { name: _de,  simple: "${exchangeProperty._row[data_element_id]}" }
              - setProperty: { name: _coc, simple: "${exchangeProperty._row[category_option_combo_id]}" }
              - setProperty: { name: _aoc, simple: "${exchangeProperty._row[attribute_option_combo_id]}" }

              - choice:
                  when:
                    - simple: "${exchangeProperty.orgUnit} == null || ${exchangeProperty.orgUnit} == '' || ${exchangeProperty.period} == null || ${exchangeProperty.period} == ''"
                      steps:
                        - setProperty: { name: _found, constant: false }
                        - setProperty: { name: _val,   constant: null }
                        - setProperty: { name: _resp,  constant: "{\"message\":\"Missing orgUnit/period\"}" }
                        - toD: "bean:operationLogService?method=logDhis2Response(${exchangeProperty._opUuid}, ${exchangeProperty._resp}, false)"
                  otherwise:
                    steps:
                      - removeHeaders: { pattern: "CamelHttp*" }
                      - setHeader:     { name: CamelHttpMethod, constant: GET }
                      - setBody:       { simple: "${null}" }
                      - toD:
                          uri: "{{dhis2.base-url}}/api/dataValues?httpMethod=GET&de=${exchangeProperty._de}&pe=${exchangeProperty.period}&ou=${exchangeProperty.orgUnit}&co=${exchangeProperty._coc}&ao=${exchangeProperty._aoc}&authenticationPreemptive=true&authUsername={{dhis2.username}}&authPassword={{dhis2.password}}&throwExceptionOnFailure=false&connectTimeout={{dhis2.connect-timeout:10000}}&socketTimeout={{dhis2.timeout:30000}}"
                      - setProperty: { name: _code, simple: "${header.CamelHttpResponseCode}" }
                      - setProperty: { name: _resp, simple: "${bodyAs(String)}" }

                      - choice:
                          when:
                            - simple: "${exchangeProperty._code} == 200 && ${exchangeProperty._resp} startsWith '{'"
                              steps:
                                - unmarshal: { json: { library: Jackson } }
                                - choice:
                                    when:
                                      - simple: "${body[value]} != null"
                                        steps:
                                          - setProperty: { name: _val, simple: "\"${body[value]}\"" }
                                          - setProperty: { name: _found, constant: true }
                                    otherwise:
                                      steps:
                                        - setProperty: { name: _val,   constant: null }
                                        - setProperty: { name: _found, constant: false }
                                - toD: "bean:operationLogService?method=logDhis2Response(${exchangeProperty._opUuid}, ${exchangeProperty._resp}, ${exchangeProperty._found})"
                          otherwise:
                            steps:
                              - choice:
                                  when:
                                    - simple: "${exchangeProperty._code} == 200 && ${exchangeProperty._resp} startsWith '['"
                                      steps:
                                        - unmarshal: { json: { library: Jackson } }
                                        - setBody:    { jsonpath: "$[0]" }
                                        - setProperty: { name: _val,   simple: "\"${body}\"" }
                                        - setProperty: { name: _found, constant: true }
                                        - toD: "bean:operationLogService?method=logDhis2Response(${exchangeProperty._opUuid}, ${exchangeProperty._resp}, true)"
                                  otherwise:
                                    steps:
                                      - setProperty: { name: _val,   constant: null }
                                      - setProperty: { name: _found, constant: false }
                                      - toD: "bean:operationLogService?method=logDhis2Response(${exchangeProperty._opUuid}, ${exchangeProperty._resp}, false)"

              - setBody:
                  simple: >
                    {"externalKey":"${exchangeProperty._ext}","dataElementId":"${exchangeProperty._de}","value":${exchangeProperty._val},"dataFound":${exchangeProperty._found}}
              - unmarshal: { json: { library: Jackson } }

        # --------- [D] فلترة onlyFound + إنهاء العملية ----------
        - marshal:   { json: { library: Jackson } }
        - unmarshal: { json: { library: Jackson } }
        - choice:
            when:
              - simple: "${exchangeProperty.onlyFound} == 'true'"
                steps:
                  - setBody: { jsonpath: "$[?(@.dataFound == true)]" }
            otherwise:
              steps:
                - setBody: { jsonpath: "$[*]" }
        - marshal:   { json: { library: Jackson } }
        - setHeader: { name: Content-Type, constant: "application/json; charset=UTF-8" }
        - toD: "bean:operationLogService?method=completeOperation(${exchangeProperty._opUuid}, true, ${bodyAs(String)})", active=true, defaultVersion=true, createdAt=2025-08-21T13:14:17.134821, comment=null)] versions
