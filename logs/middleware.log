    id: dhis2-upload-csv-sync
    description: "POST /external/integrate - CSV upload (RAW or multipart) with ?scheme=UID|CODE|NAME, sync import, return DHIS2 response verbatim"
    from:
      uri: servlet:/external/integrate
      parameters:
        httpMethodRestrict: POST
    steps:
      # ============ استلام CSV (يدعم multipart أو RAW) ============
      - choice:
          when:
            - simple: "${header['Content-Type']} regex '(?i).*multipart/form-data.*'"
              steps:
                - setProperty:
                    name: _req
                    simple: "${header['CamelHttpServletRequest']}"
                - setHeader:
                    name: CamelFileName
                    simple: "${exchangeProperty._req != null && exchangeProperty._req.getPart('file') != null ? exchangeProperty._req.getPart('file').getSubmittedFileName() : 'uploaded.csv'}"
                - setBody:
                    simple: "${exchangeProperty._req != null && e]
